{
  "name": "class-pet-desktop",
  "version": "1.2.8",
  "description": "Class Pet 班级电子宠物管理系统 (Windows 11 现代触控版)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "process:pets": "python scripts/process_pets.py"
  },
  "keywords": [
    "electron",
    "classroom",
    "neo-brutalism",
    "smart-whiteboard"
  ],
  "author": "Class Pet Team",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.8.2"
  },
  "build": {
    "appId": "com.classpet.classroom",
    "productName": "ClassPet",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "sqlite_service.js",
      "update_check.js",
      "xlsx_lite.js",
      "src/**/*",
      "!src/assets/pets_raw/**/*"
    ],
    "extraResources": [
      {
        "from": "../database/classpet.sqlite",
        "to": "database/classpet.sqlite"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icons/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "班级电子宠物管理系统"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  }
}
