{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MindFlowCanvasProject",
  "description": "Standard JSON Data Schema for MindFlow Canvas Mindmap Projects",
  "type": "object",
  "required": ["projectTitle", "nodes", "wires"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique Project Identifier"
    },
    "projectTitle": {
      "type": "string",
      "description": "Title of the mindmap/canvas project"
    },
    "description": {
      "type": "string",
      "description": "Optional summary or subtitle of the project"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last modification"
    },
    "nodes": {
      "type": "array",
      "description": "List of graphic nodes in the canvas",
      "items": {
        "type": "object",
        "required": ["id", "shape", "x", "y", "width", "height", "title"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["card", "circle", "rect", "diamond", "sticky", "pill", "frame", "ai_prompt"]
          },
          "shape": {
            "type": "string",
            "enum": ["card", "circle", "rect", "diamond", "sticky", "pill", "frame", "ai_prompt"]
          },
          "x": { "type": "number", "description": "X coordinate in canvas world space" },
          "y": { "type": "number", "description": "Y coordinate in canvas world space" },
          "width": { "type": "number", "description": "Node box width in pixels" },
          "height": { "type": "number", "description": "Node box height in pixels" },
          "title": { "type": "string", "description": "Primary node headline/title" },
          "content": { "type": "string", "description": "Detailed text content/bullet points" },
          "color": {
            "type": "string",
            "enum": ["cyan", "purple", "emerald", "amber", "rose", "blue", "slate"],
            "default": "cyan"
          },
          "tag": { "type": "string", "description": "Optional badge tag in card header" },
          "icon": { "type": "string", "description": "Lucide icon name (e.g. sparkles, camera)" },
          "zIndex": { "type": "number", "default": 10 }
        }
      }
    },
    "wires": {
      "type": "array",
      "description": "List of connecting relationship wires between nodes",
      "items": {
        "type": "object",
        "required": ["id", "fromNode", "fromPort", "toNode", "toPort"],
        "properties": {
          "id": { "type": "string" },
          "fromNode": { "type": "string", "description": "Source node ID" },
          "fromPort": {
            "type": "string",
            "enum": ["top", "right", "bottom", "left"],
            "default": "right"
          },
          "toNode": { "type": "string", "description": "Target node ID" },
          "toPort": {
            "type": "string",
            "enum": ["top", "right", "bottom", "left"],
            "default": "left"
          },
          "label": { "type": "string", "description": "Relationship text label shown on wire" },
          "style": {
            "type": "string",
            "enum": ["bezier", "orthogonal", "straight"],
            "default": "bezier"
          },
          "color": {
            "type": "string",
            "enum": ["cyan", "purple", "emerald", "amber", "rose", "slate"],
            "default": "cyan"
          },
          "animated": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
